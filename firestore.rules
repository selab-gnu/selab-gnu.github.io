rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function bootstrapAdmin() {
   return request.auth != null
    && request.auth.token.email == 'yeonu7787@gmail.com'
    && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com';
  }
  function editorRole(role) {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && exists(/databases/$(database)/documents/editorRoles/$(request.auth.token.email.lower()))
    && get(/databases/$(database)/documents/editorRoles/$(request.auth.token.email.lower())).data.role == role;
  }
  function admin() {
   return bootstrapAdmin() || editorRole('admin');
  }
  match /editorRoles/{email} {
   allow get: if admin() || (request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.lower() == email);
   allow list, delete: if admin();
   allow create, update: if admin() && request.resource.data.keys().hasAll(['role'])
    && request.resource.data.keys().hasOnly(['role','memberId'])
    && email != 'yeonu7787@gmail.com'
    && request.resource.data.role in ['admin','member','visitor']
    && (request.resource.data.role != 'visitor' || !('memberId' in request.resource.data))
    && (request.resource.data.role != 'member' || 'memberId' in request.resource.data)
    && (!('memberId' in request.resource.data) || (request.resource.data.memberId is string
      && exists(/databases/$(database)/documents/memberProfiles/$(request.resource.data.memberId))));
  }
  function valid() {
   let d = request.resource.data;
   return d.keys().hasAll(['version','home','members','groups','revision','updatedAt'])
    && d.keys().hasOnly(['version','home','members','groups','revision','updatedAt','memberDirectoryVersion'])
    && (!('memberDirectoryVersion' in d) || d.memberDirectoryVersion == 1)
    && d.version == 1 && d.home is string && d.home.size() < 200000
    && d.members is string && d.members.size() < 300000
    && d.groups is list && d.groups.size() == 4
    && d.revision is int && d.updatedAt == request.time;
  }
  match /siteContent/main {
   allow get: if true;
   allow create: if admin() && valid() && request.resource.data.revision == 1;
   allow update: if admin() && valid() && request.resource.data.revision == resource.data.revision + 1
    && (!('memberDirectoryVersion' in resource.data) || request.resource.data.memberDirectoryVersion == 1);
   allow delete, list: if false;
  }
  function ownProfile(id) {
   return editorRole('member')
    && get(/databases/$(database)/documents/editorRoles/$(request.auth.token.email.lower())).data.memberId == id;
  }
  function validProfile() {
   let d = request.resource.data;
   return d.keys().hasAll(['name','html','bio','group','order','revision','updatedAt'])
    && d.keys().hasOnly(['name','html','bio','group','order','revision','updatedAt'])
    && d.name is string && d.name.size() > 0 && d.name.size() <= 300
    && d.html is string && d.html.size() <= 30000
    && d.bio is string && d.bio.size() <= 10000
    && d.group in ['current','graduates','undergraduates']
    && d.order is int && d.revision is int && d.updatedAt == request.time;
  }
  match /memberProfiles/{id} {
   allow read: if true;
   allow create: if admin() && validProfile() && request.resource.data.revision == 1;
   allow update: if validProfile() && request.resource.data.revision == resource.data.revision + 1
    && (admin() || (ownProfile(id)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bio','revision','updatedAt'])));
   allow delete: if admin();
  }
  function validPost() {
   let d = request.resource.data;
   return d.title is string && d.title.size() > 0 && d.title.size() <= 200
    && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
    && d.revision is int && d.updatedAt == request.time;
  }
  match /newsItems/{id} {
   allow read: if true;
   allow create, update: if admin() && validPost()
    && request.resource.data.keys().hasAll(['title','date','body','revision','updatedAt'])
    && request.resource.data.keys().hasOnly(['title','date','body','revision','updatedAt'])
    && request.resource.data.body is string && request.resource.data.body.size() > 0 && request.resource.data.body.size() <= 10000
    && ((!exists(/databases/$(database)/documents/newsItems/$(id)) && request.resource.data.revision == 1)
      || (exists(/databases/$(database)/documents/newsItems/$(id)) && request.resource.data.revision == resource.data.revision + 1));
   allow delete: if admin();
  }
  match /galleryItems/{id} {
   allow read: if true;
   allow create, update: if admin() && validPost()
    && request.resource.data.keys().hasAll(['title','date','image','caption','revision','updatedAt'])
    && request.resource.data.keys().hasOnly(['title','date','image','caption','revision','updatedAt'])
    && request.resource.data.image is string && request.resource.data.image.size() > 0 && request.resource.data.image.size() <= 240000
    && request.resource.data.image.matches('^(https://.+|data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+)$')
    && request.resource.data.caption is string && request.resource.data.caption.size() <= 2000
    && ((!exists(/databases/$(database)/documents/galleryItems/$(id)) && request.resource.data.revision == 1)
      || (exists(/databases/$(database)/documents/galleryItems/$(id)) && request.resource.data.revision == resource.data.revision + 1));
   allow delete: if admin();
  }
 }
}
